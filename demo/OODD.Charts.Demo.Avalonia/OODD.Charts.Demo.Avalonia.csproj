  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.6" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.6" />
    <ProjectReference Include="..\OODD.Charts.Demo.Common\OODD.Charts.Demo.Common.csproj" />
    <ProjectReference Include="..\..\src\Adapters\OODD.Charts.Adapters.Avalonia\OODD.Charts.Adapters.Avalonia.csproj" />
  </ItemGroup>

</Project>
