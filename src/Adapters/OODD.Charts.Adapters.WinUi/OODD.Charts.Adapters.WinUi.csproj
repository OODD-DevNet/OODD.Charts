<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <Platforms>AnyCPU;x64</Platforms>
    <AssemblyName>OODD.Charts.Adapters.WinUi</AssemblyName>
    <!-- 纯 C# 适配器无 PRI/XAML 资源，也不打包 MSIX；本机构建（无 Visual Studio 的
         AppxPackage/Appx 任务集 Microsoft.Build.AppxPackage.dll）下必须关掉
         WindowsAppSDK 的 PriGen 与 Msix 工具链，否则 MSB4062（详见 docs/02 勘误）。 -->
    <AppxGeneratePriEnabled>false</AppxGeneratePriEnabled>
    <AppxGeneratePrisForPortableLibrariesEnabled>false</AppxGeneratePrisForPortableLibrariesEnabled>
    <AppxGetPackagePropertiesEnabled>false</AppxGetPackagePropertiesEnabled>
    <IncludeProjectPriFile>false</IncludeProjectPriFile>
    <EnableMsixTooling>false</EnableMsixTooling>
    <GenerateLibraryLayout>false</GenerateLibraryLayout>
    <EnableCoreMrtTooling>false</EnableCoreMrtTooling>
    <!-- ProjectReference 求值时会跑 GetMrtPackagingOutputs（WindowsAppSDK 的 buildTransitive
         资产会经传递引用渗进被引用的 Core 工程），其中的 CopyLocalFilesOutputGroup 依赖
         VS 自带的 Microsoft.Build.AppxPackage.dll；无 VS 机器上整组输出都不需要，直接关掉。 -->
    <IncludeCopyLocalFilesOutputGroup>false</IncludeCopyLocalFilesOutputGroup>
    <RootNamespace>OODD.Charts.Adapters.WinUi</RootNamespace>
    <IsPackable>true</IsPackable>
    <Description>WinUI 3 宿主适配器：Raster/SKPicture 到 Microsoft.UI.Xaml WriteableBitmap 的像素桥 + ChartControl。</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.260224002" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\OODD.Charts.Core\OODD.Charts.Core.csproj" />
  </ItemGroup>

</Project>
