<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net462;netstandard2.0;net8.0</TargetFrameworks>
    <RootNamespace>OODD.Charts</RootNamespace>
    <AssemblyName>OODD.Charts.Core</AssemblyName>
    <Description>跨平台刚性网格表单渲染引擎（SkiaSharp 内核）。不含任何 UI 框架依赖。</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="$(SkiaSharpVersion)" />
    <!-- 整形内核：阿拉伯文连写、天城文辅音簇重排等 Skia 不做的事由 HarfBuzz 补齐。 -->
    <PackageReference Include="HarfBuzzSharp" Version="$(HarfBuzzSharpVersion)" />
  </ItemGroup>

</Project>
